<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head', { pageTitle: pageTitle }) %>
  </head>
  <body class="bg-gradient-to-b from-gray-100 to-gray-200 min-h-screen">
    <%- include('./partials/nav', { currentPage: currentPage }) %>

    <main class="container mx-auto mt-12 px-4 max-w-2xl">
      <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold text-red-600 mb-4">⚠️ Error Occurred</h2>
        <p class="text-gray-700 mb-6 text-lg"><%= error %></p>
        <div class="flex gap-4">
          <a href="/" class="inline-block bg-red-500 text-white px-6 py-2 rounded-md hover:bg-red-600 transition">
            🏠 Go to Home
          </a>
          <button onclick="window.history.back()" class="inline-block bg-gray-500 text-white px-6 py-2 rounded-md hover:bg-gray-600 transition">
            ← Go Back
          </button>
        </div>
      </div>
    </main>
  </body>
</html>