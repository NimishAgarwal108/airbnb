<%- include('../partials/head') %>
</head>
<body class="bg-gray-100 min-h-screen">
  <%- include('../partials/nav') %>

  <main class="container mx-auto mt-12 p-8 bg-white rounded-2xl shadow-lg max-w-xl">
    <!-- Heading -->
    <h1 class="text-3xl md:text-4xl font-extrabold mb-8 text-center text-red-500">
      <%= editing ? "Edit" : "Register" %> Your Home on AirBnB
    </h1>

    <form action="/host/<%= editing ? "edit-home/" : "add-home" %>" method="POST" class="space-y-6">
      <!-- Hidden ID -->
      <input type="hidden" name="id" value="<%= editing ? home._id : '' %>" />

      <!-- House Name -->
      <div>
        <label class="block text-gray-700 font-semibold mb-2">🏠 House Name</label>
        <input
          type="text"
          name="houseName"
          value="<%= editing ? home.houseName : '' %>"
          placeholder="Enter your House Name"
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm"
        />
      </div>

      <!-- Price -->
      <div>
        <label class="block text-gray-700 font-semibold mb-2">💵 Price per Night</label>
        <input
          type="text"
          name="price"
          value="<%= editing ? home.price : '' %>"
          placeholder="Enter price per night"
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm"
        />
      </div>

      <!-- Location -->
      <div>
        <label class="block text-gray-700 font-semibold mb-2">📍 Location</label>
        <input
          type="text"
          name="location"
          value="<%= editing ? home.location : '' %>"
          placeholder="Enter location"
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm"
        />
      </div>

      <!-- Rating -->
      <div>
        <label class="block text-gray-700 font-semibold mb-2">⭐ Rating</label>
        <input
          type="text"
          name="rating"
          value="<%= editing ? home.rating : '' %>"
          placeholder="Enter rating"
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm"
        />
      </div>

      <!-- Photo URL -->
      <div>
        <label class="block text-gray-700 font-semibold mb-2">🖼️ Photo URL</label>
        <input
          type="text"
          id="photoUrl"
          name="photoUrl"
          value="<%= editing ? home.photoUrl : '' %>"
          placeholder="Enter photo URL"
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm"
        />
      </div>

      <!-- Submit Button -->
      <div>
        <input 
          type="submit" 
          value="<%= editing ? "Update Home" : "Submit" %>"
          class="w-full bg-red-500 text-white py-3 rounded-lg hover:bg-red-600 transition duration-300 font-semibold shadow-md"
        />
      </div>
    </form>
  </main>
</body>
</html>
