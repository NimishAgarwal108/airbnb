<%- include('../partials/head') %>
</head>
<body class="bg-gray-100 min-h-screen">
  <%- include('../partials/nav') %>

  <main class="container mx-auto mt-12 p-8 bg-white rounded-2xl shadow-lg max-w-xl">
    <!-- Heading -->
    <h1 class="text-3xl md:text-4xl font-extrabold mb-8 text-center text-red-500">
      <%= editing ? "Edit" : "Register" %> Your Home on AirBnB
    </h1>

    <form action="/host/<%= editing ? "edit-home" : "add-home" %>" method="POST" enctype="multipart/form-data" class="space-y-6">
      <!-- Hidden ID -->
      <input type="hidden" name="id" value="<%= editing ? home._id : '' %>" />

      <!-- House Name -->
      <div>
        <label class="block text-gray-700 font-semibold mb-2">🏠 House Name</label>
        <input
          type="text"
          name="houseName"
          value="<%= editing ? home.houseName : '' %>"
          placeholder="Enter your House Name"
          required
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm"
        />
      </div>

      <!-- Price -->
      <div>
        <label class="block text-gray-700 font-semibold mb-2">💵 Price per Night</label>
        <input
          type="number"
          name="price"
          value="<%= editing ? home.price : '' %>"
          placeholder="Enter price per night"
          required
          min="0"
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm"
        />
      </div>

      <!-- Location -->
      <div>
        <label class="block text-gray-700 font-semibold mb-2">📍 Location</label>
        <input
          type="text"
          name="location"
          value="<%= editing ? home.location : '' %>"
          placeholder="Enter location"
          required
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm"
        />
      </div>

      <!-- Rating -->
      <div>
        <label class="block text-gray-700 font-semibold mb-2">⭐ Rating</label>
        <input
          type="number"
          name="rating"
          value="<%= editing ? home.rating : '' %>"
          placeholder="Enter rating (1-5)"
          required
          min="1"
          max="5"
          step="0.1"
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm"
        />
      </div>

      <!-- Photo Upload -->
      <div>
        <label class="block text-gray-700 font-semibold mb-2">📷 Upload Photo</label>
        <div class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:border-red-500 transition">
          <input
            type="file"
            id="photo"
            name="photo"
            accept="image/jpeg,image/jpg,image/png"
            <%= !editing ? 'required' : '' %>
            class="hidden"
            onchange="updateFileName(this)"
          />
          <label for="photo" class="cursor-pointer">
            <div class="flex flex-col items-center">
              <svg class="w-12 h-12 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
              </svg>
              <span class="text-sm text-gray-600">Click to upload or drag and drop</span>
              <span class="text-xs text-gray-500 mt-1">JPG, JPEG, PNG (Max 5MB)</span>
              <span id="file-name" class="text-sm text-red-500 font-semibold mt-2"></span>
            </div>
          </label>
        </div>
        <% if (editing && home.photo) { %>
          <div class="mt-3">
            <p class="text-sm text-gray-600 mb-2">Current photo:</p>
            <img src="<%= home.photo %>" alt="Current home photo" class="w-32 h-32 object-cover rounded-lg border-2 border-gray-200">
            <p class="text-xs text-gray-500 mt-1">Leave empty to keep current photo</p>
          </div>
        <% } %>
      </div>

      <!-- Submit Button -->
      <div>
        <button 
          type="submit"
          class="w-full bg-red-500 text-white py-3 rounded-lg hover:bg-red-600 transition duration-300 font-semibold shadow-md cursor-pointer"
        >
          <%= editing ? "Update Home" : "Submit" %>
        </button>
      </div>
    </form>
  </main>

  <script>
    function updateFileName(input) {
      const fileName = input.files[0]?.name;
      const fileNameSpan = document.getElementById('file-name');
      if (fileName) {
        fileNameSpan.textContent = fileName;
      } else {
        fileNameSpan.textContent = '';
      }
    }
  </script>

  <%- include('../partials/spinner') %>
</body>
</html>