<%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md max-w-xl">
    <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">
      Please Login to your account
    </h1>
    <form action="/login" method="POST">
      <!-- email-->
      <div class="mb-6">
        <input
          type="email"
          value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>"
          name="email"
          placeholder="Enter your email"
          class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
          required
        />
         <%- include('../partials/error', { errors: errors, field: 'email' }) %>
      </div>

      <!-- Password -->
      <div class="mb-6">
        <input
          type="password"
          name="password"
          placeholder="Enter your password"
          class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
          required
        />
         <%- include('../partials/error', { errors: errors, field: 'password' }) %>
      </div>

      <!-- Submit Button -->
      <div>
        <input 
          type="submit" 
          value="Login" 
          class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300"
        />
      </div>
    </form>

    <!-- Signup Link -->
    <p class="mt-4 text-center text-gray-700">
      Don't have an account? 
      <a href="/signup" class="text-red-500 hover:text-red-700 font-semibold">Sign up</a>
    </p>
  </main>
</body>
</html>
